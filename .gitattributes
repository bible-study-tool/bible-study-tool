# Ensure deterministic LF line endings across all platforms (ADR-024, ADR-027).
# Prevents cryptographic checksum mismatches on Windows runners.
* text=auto eol=lf

# Explicitly declare text files that must retain LF
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.py text eol=lf
*.go text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.spec text eol=lf
*.csv text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.svg text eol=lf

# Windows command scripts (require CRLF if ever added)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files must never undergo newline conversion
*.zip binary
*.db binary
*.sqlite* binary
*.exe binary
*.gz binary
*.tar.gz binary
*.png binary
*.ico binary
